# ---------------------------------------------------------------------------
#  Secrets — nothing in this block may ever be committed.
#
#  GGCMS takes its database credentials from PHP's mysqli.default_* directives
#  in php.ini, which means php.ini IS a credential file on a live host.  It is
#  ignored here on purpose; Docs/Installation.md documents the directives you
#  need to set instead.
# ---------------------------------------------------------------------------

php.ini
etc/ggcms/*/secrets/
etc/ggcms/secrets/
**/conf.d/*mysqli*.ini
.digitalocean_password
digitalocean*.txt
*.pem
*.key
!*.pub

# ---------------------------------------------------------------------------
#  Site content and operational data.
#
#  /srv/ggcms/<domain>/ holds uploaded images and per-site payload; on the live
#  host it runs to several gigabytes.  It is backed up separately and does not
#  belong in a code repository.
# ---------------------------------------------------------------------------

srv/
var/log/
root/database-imports/

# Database dumps and backups (cli/sql/clonefrom.sql is schema and IS tracked)
/*.sql
/*.sql.gz
*-TRUTH-*.sql
backup-*.sql

# ---------------------------------------------------------------------------
#  Generated output.  The static page cache is built at runtime and flushed on
#  any database write; it must never be committed.  See Docs/PageCache.md.
# ---------------------------------------------------------------------------

var/www/html/_cache/
var/www/html/test.php

# ---------------------------------------------------------------------------
#  Editor and OS cruft.
# ---------------------------------------------------------------------------

Thumbs.db
desktop.ini
.DS_Store
*.swp
*.swo
*~
.idea/
.vscode/

#  Site configuration and site templates.
#
#  This repository is the engine, and the engine is public.  Everything that
#  describes an actual running site -- its per-domain config under etc/ggcms,
#  its database credentials, and its template set -- lives in the private
#  configuration repository instead.
#
#  What stays here is the reference material a new install clones: the
#  clonefrom config tree and the default template set.  Nothing here should
#  name a site.

etc/ggcms/*
!etc/ggcms/clonefrom/
!etc/ggcms/clonefrom.php
usr/lib/ggcms/src/templates/*
!usr/lib/ggcms/src/templates/default/
