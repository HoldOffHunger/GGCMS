	"endings": {
		"about": "The regular endings, the same list for every verb, longest first where it matters. A form ending in a vowel letter after a vowel (जाऊँगा) and one ending in a vowel sign after a consonant (बोलूँगा) are both listed. On a two-word form the ending is looked for on the first word.",
		"now": {"*": ["ता", "ते", "ती"]},
		"before": {"*": ["या", "ा", "यी", "ई", "ी", "ये", "ए", "े"]},
		"later": {"*": ["ऊँगा", "ूँगा", "ओगे", "ोगे", "येगी", "एगी", "ेगी", "येंगे", "एँगे", "ेंगे"]},
		"command": {"*": ["ओ", "ो", "इये", "िये", "इए", "िए"]}
	},

	"recipes": {
		"who": {
			"strategy": ["ending", "helper word"],
			"description": "The verb's ending changes with who is doing it, and with whether a man or a woman is the one, and a small word after it changes too: {1}, {2}, {3}, {4}.",
			"own_way": " {Base} goes its own way here, so learn these four as they are.",
			"rows": [
				{"english": "I {base}", "features": {"who": "i", "when": "now"}, "endings": "now", "wrap": "मैं {}"},
				{"english": "You {base}", "features": {"who": "you", "when": "now"}, "endings": "now", "wrap": "तुम {}"},
				{"english": "She {s}", "features": {"who": "she", "when": "now"}, "endings": "now", "wrap": "वह {}"},
				{"english": "We {base}", "features": {"who": "we", "when": "now"}, "endings": "now", "wrap": "हम {}"}
			]
		},
		"when": {
			"strategy": ["ending"],
			"description": "For before, the verb changes on its own, and still says whether a man or a woman is the one: {2}, {4}. For later, it takes an ending of its own: {3}.",
			"own_way": " {Base} goes its own way here, so learn these as they are.",
			"rows": [
				{"english": "I {base}", "features": {"who": "i", "when": "now"}, "wrap": "मैं {}"},
				{"english": "I {past}", "features": {"who": "i", "when": "before"}, "endings": "before", "wrap": "मैं {}", "from": 1},
				{"english": "I will {base}", "features": {"who": "i", "when": "later"}, "endings": "later", "wrap": "मैं {}", "from": 1},
				{"english": "She {past}", "features": {"who": "she", "when": "before"}, "endings": "before", "wrap": "वह {}"}
			],
			"variants": [
				{"if_form": {"when": "before", "ne": "yes"},
				 "description": "For before, {Base} takes ने on the one doing it, and then matches what was done rather than who did it, so it is the same for her as for me: {2}, {4}. For later, it takes an ending of its own: {3}.",
				 "rows": [
					{"english": "I {base}", "features": {"who": "i", "when": "now"}, "wrap": "मैं {}"},
					{"english": "I {past}", "features": {"when": "before", "ne": "yes"}, "endings": "before", "wrap": "मैंने {}", "words": [{"text": "ने", "role": "particle"}], "from": 1, "says": {"who": "i", "when": "before"}},
					{"english": "I will {base}", "features": {"who": "i", "when": "later"}, "endings": "later", "wrap": "मैं {}", "from": 1},
					{"english": "She {past}", "features": {"when": "before", "ne": "yes"}, "endings": "before", "wrap": "उसने {}", "words": [{"text": "ने", "role": "particle"}], "says": {"who": "she", "when": "before"}}
				 ]}
			]
		},
		"going": {
			"strategy": ["helper word"],
			"skip": "stative",
			"description": "For something going on right now, रहा goes after the verb's short form, and a woman says रही: {2}, {4}.",
			"rows": [
				{"english": "I {base}", "features": {"who": "i", "when": "now"}, "wrap": "मैं {}"},
				{"english": "I am {ing}", "features": {"who": "i", "when": "now", "going": "yes"}, "wrap": "मैं {}", "from": 1},
				{"english": "She {s}", "features": {"who": "she", "when": "now"}, "wrap": "वह {}"},
				{"english": "She is {ing}", "features": {"who": "she", "when": "now", "going": "yes"}, "wrap": "वह {}", "from": 3}
			]
		},
		"command": {
			"strategy": ["ending", "helper word"],
			"skip": "stative",
			"description": "To a friend, the verb ends in o: {1} To someone you call आप, in iye: {2} Telling them not to puts मत in front: {3} {4}",
			"rows": [
				{"english": "{Base}!", "features": {"command": "yes", "who": "you"}, "endings": "command", "wrap": "{}!"},
				{"english": "{Base}! said politely", "features": {"command": "yes", "who": "you", "polite": "yes"}, "endings": "command", "wrap": "{}!"},
				{"english": "Do not {base}!", "features": {"command": "yes", "who": "you"}, "wrap": "मत {}!", "words": ["मत"], "from": 1, "says": {"command": "yes", "who": "you", "not": "yes"}},
				{"english": "Do not {base}! said politely", "features": {"command": "yes", "who": "you", "polite": "yes"}, "wrap": "मत {}!", "words": ["मत"], "from": 2, "says": {"command": "yes", "who": "you", "not": "yes", "polite": "yes"}}
			]
