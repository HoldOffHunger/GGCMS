	"ergative": {"about": "The verbs that take ने on the one doing it in the past (मैंने खाया), written out by hand: the dump marks few verbs transitive, and लाना, ले जाना, बोलना, समझना, भूलना, जीतना and हारना are said without it (मैं लाया). Their past matches what was done, so it is one form rather than a column by who. A compound takes ने when its last verb does (बर्बाद करना, not रवाना होना).", "when": "before", "features": {"when": "before", "ne": "yes"}, "verbs": ["अंतर करना", "अभिनय करना", "आदर करना", "उठाना", "उबालना", "कमाना", "करना", "कहना", "काटना", "खरीदना", "खाना", "खिलाना", "खींचना", "खेलना", "खोजना", "खोलना", "ग़ौर करना", "गाना", "गिरफ़्तार करना", "घसीटना", "घुसाना", "चलाना", "चाहना", "चुराना", "छाँटना", "छापना", "छिपाना", "छोड़ देना", "छोड़ना", "जगाना", "जमा करना", "जलाना", "जानना", "जोड़ना", "डालना", "ढकना", "ढूँढना", "तैयार करना", "तौलना", "थोपना", "दबाना", "दिखाना", "देखना", "देना", "दोहराना", "धमकाना", "धरना", "धोना", "नक़ल करना", "निकालना", "निगलना", "नियुक्त करना", "निवेदन करना", "पकड़ना", "पकाना", "पढ़ना", "पढ़ाना", "परवाह करना", "पहचानना", "पहनाना", "पाना", "पीना", "पूछना", "पोंछना", "प्रकाशित करना", "प्रवेश करना", "प्राप्त करना", "फाड़ना", "फेंकना", "फैलाना", "बचाना", "बढ़ाना", "बताना", "बदलना", "बनाना", "बाँधना", "बांटना", "बिताना", "बुलाना", "बेचना", "भरना", "भरोसा करना", "भुगतना", "भेजना", "माँगना", "मानना", "मापना", "मार डालना", "मारना", "मोड़ना", "रंगना", "रक्षा करना", "रखना", "रगड़ना", "राज करना", "रोकना", "लिखना", "लेना", "विकसित करना", "सँभालना", "संभालना", "समझाना", "सराहना", "सहेजना", "साँस लेना", "सिखाना", "सीखना", "सुझाना", "सुधारना", "सुनना", "सूँघना", "सूचित करना", "सोचना", "स्थापित करना", "स्वीकार करना", "हटाना", "हिलाना"]},
	"light_verbs": {"about": "A compound like बर्बाद करना or रवाना होना takes the light verb's forms with the first word in front (बर्बाद करता हूँ, बर्बाद मत करो). Not where the front begins with a postposition: के पास होना is 'to have' and is said मेरे पास है.", "verbs": ["करना", "होना"], "not_after": ["के", "की", "का", "में", "से", "पर", "को"]},
