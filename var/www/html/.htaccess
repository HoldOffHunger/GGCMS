RewriteEngine On
RewriteBase /

# ---------------------------------------------------------------------------
#  Canonical hostname.
#
#  One host, one cached copy.  The cache filename carries %{HTTP_HOST}, so a
#  site reachable as both example.com and www.example.com fills two complete
#  trees of identical pages and halves its own hit rate paying for it.  On
#  2026-09-03 that was 440 MB of the 1,004 MB page cache: wordweight alone held
#  399 MB bare and 374 MB under www.
#
#  Bare wins because the engine already agrees.  Domain::SetDomain strips a
#  leading 'www.' from primary_domain, and GetPrimaryDomain has its www line
#  commented out -- everything downstream of those already thinks in bare
#  domains.  Handler.php was the last thing still building 'https://www.', in
#  seven redirect builders, and no longer does.
#
#  This must come before the cache rules.  Placed after them, a www request
#  with a warm www cache entry would be served from it and never reach here,
#  and the duplicate tree would go on being used forever.
#
#  https:// in the target is deliberate: every site on this host has a
#  certificate covering the bare domain, so an insecure www request is
#  corrected in one hop instead of two.
# ---------------------------------------------------------------------------

RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,QSA,L]

# ---------------------------------------------------------------------------
#  Static page cache.
#
#  A cached page is an ordinary file.  When one exists, Apache serves it and
#  PHP is never started -- no Handler, no database, none of the ~1700 queries
#  a render costs.  Everything that fails these conditions falls through to
#  the front controller below and renders normally.
#
#  The cache is written by classes/Cache/PageCache.php, which computes exactly
#  the two filename forms tested here.  Change one and you must change both.
#  See Docs/PageCache.md.
# ---------------------------------------------------------------------------

		#  Stop immediately if we are already inside the cache tree, so an
		#  internal rewrite cannot re-enter these rules.

RewriteRule ^_cache/ - [L]

		#  Never serve cache to a request that could be personalised, that
		#  carries parameters, or that is not a plain read.  These cookie
		#  names must match PageCache::IsCacheable_Anonymous().

		#  The -f test uses an absolute path rather than %{DOCUMENT_ROOT}.
		#  With the variable, neither rule ever fired even though the file was
		#  present, servable, and at exactly the path being tested -- consistent
		#  with DOCUMENT_ROOT expanding empty in per-directory context here.
		#  DocumentRoot is /var/www/html for every vhost (see Docs/Installation.md).

		#  Directory-style URLs, ending in a slash.  The pattern is `^` rather
		#  than `^(.*/)$` because in per-directory context mod_rewrite strips the
		#  leading slash, so a request for `/` presents an EMPTY string -- which
		#  `^(.*/)$` cannot match, and the homepage silently never cached.

RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{QUERY_STRING} ^$
RewriteCond %{HTTP_COOKIE} !(loggedin|AuthenticationToken) [NC]
RewriteCond %{REQUEST_URI} /$
RewriteCond /var/www/html/_cache/%{HTTP_HOST}%{REQUEST_URI}index.html -f
RewriteRule ^(.*)$ /_cache/%{HTTP_HOST}%{REQUEST_URI}index.html [L]

		#  Generated stylesheets.  style.php renders through the CSS format
		#  class, so /css/view/display.css is PHP, not a file.  The cached copy
		#  keeps a .css suffix so Apache serves it as text/css.

RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{QUERY_STRING} ^$
RewriteCond %{HTTP_COOKIE} !(loggedin|AuthenticationToken) [NC]
RewriteCond %{REQUEST_URI} \.css$
RewriteCond /var/www/html/_cache/%{HTTP_HOST}%{REQUEST_URI}.css -f
RewriteRule ^(.*)$ /_cache/%{HTTP_HOST}%{REQUEST_URI}.css [L]

		#  Everything else: <path>.html

RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{QUERY_STRING} ^$
RewriteCond %{HTTP_COOKIE} !(loggedin|AuthenticationToken) [NC]
RewriteCond %{REQUEST_URI} !/$
RewriteCond /var/www/html/_cache/%{HTTP_HOST}%{REQUEST_URI}.html -f
RewriteRule ^(.*)$ /_cache/%{HTTP_HOST}%{REQUEST_URI}.html [L]

# ---------------------------------------------------------------------------
#  Front controller.
#
#  No request may reach a PHP file directly.  Anything that does not name a
#  real file on disk becomes index.php, which reads the path as an entry-graph
#  walk rather than a filesystem path.  See Docs/Architecture.md.
# ---------------------------------------------------------------------------

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ index.php [QSA,NC,L]
