{
	"about": "How Dutch verb forms are read out of the Wiktionary dump and turned into lessons. make_forms.py uses `slots`; make_form_lessons.py uses the rest. Everything Dutch about the conjugation system lives in this one file. Written by Claude with Ben on 15 November 2026, alongside the German one. Dutch works as German does (a helper and a changed verb for before, a helper for later) with two differences in what the dictionary gives. Its table has one form for we, you all and they, so those three share a slot. And it does not say which helper a verb takes, so every verb takes hebben unless `helper_of` names it: that list is the common verbs of going and changing, and a rarer one missing from it will show hebben where it should show zijn. Going on right now is zijn, then aan het, then the whole verb: ik ben aan het eten. Verbs that split in two (aankomen: ik kom aan) are in the tables and not yet in the lessons.",
	"language": "dutch",
	"translation_language": "nl",
	"dump": "kaikki.org-dictionary-Dutch.jsonl",
	"dictionary_form": {"form": "infinitive"},
	"skip_tags": ["table-tags", "inflection-template", "class", "gerund", "subordinate-clause"],
	"helper_verbs": ["hebben", "zijn", "zullen"],
	"helper_default": "hebben",
	"helper_of_endings": {"gaan": "zijn", "komen": "zijn", "vallen": "zijn", "blijven": "zijn"},
	"helper_of": {"begaan": "hebben", "ondergaan": "hebben", "aanvallen": "hebben", "verwelkomen": "hebben", "gaan": "zijn", "komen": "zijn", "blijven": "zijn", "zijn": "zijn", "worden": "zijn", "vallen": "zijn", "beginnen": "zijn", "gebeuren": "zijn", "sterven": "zijn", "vertrekken": "zijn", "aankomen": "zijn", "opstaan": "zijn", "verdwijnen": "zijn", "verschijnen": "zijn", "groeien": "zijn", "stijgen": "zijn", "dalen": "zijn", "slagen": "zijn", "lukken": "zijn", "ontstaan": "zijn", "terugkomen": "zijn", "binnenkomen": "zijn", "thuiskomen": "zijn", "vergeten": "zijn", "stoppen": "zijn", "opgroeien": "zijn", "trouwen": "zijn", "verhuizen": "zijn", "veranderen": "zijn", "ontsnappen": "zijn", "emigreren": "zijn"},
	"slots": [
		{"features": {"form": "infinitive"}, "tags": ["infinitive"]},
		{"features": {"form": "done"}, "tags": ["participle", "past"]},

		{"features": {"who": "i", "when": "now"}, "tags": ["first-person", "singular", "present"], "without": ["formal", "Flanders", "archaic", "imperative", "participle"]},
		{"features": {"who": "you", "when": "now"}, "tags": ["second-person", "singular", "present"], "without": ["formal", "Flanders", "archaic", "imperative", "participle"]},
		{"features": {"who": "she", "when": "now"}, "tags": ["third-person", "singular", "present"], "without": ["formal", "Flanders", "archaic", "imperative", "participle"]},
		{"features": {"who": "we", "when": "now"}, "tags": ["plural", "present"], "without": ["formal", "Flanders", "archaic", "imperative", "participle"]},
		{"features": {"who": "you-all", "when": "now"}, "tags": ["plural", "present"], "without": ["formal", "Flanders", "archaic", "imperative", "participle"]},
		{"features": {"who": "they", "when": "now"}, "tags": ["plural", "present"], "without": ["formal", "Flanders", "archaic", "imperative", "participle"]},

		{"features": {"who": "i", "when": "before"}, "compound": {"helper": {"who": "i", "when": "now"}, "part": {"form": "done"}}},
		{"features": {"who": "you", "when": "before"}, "compound": {"helper": {"who": "you", "when": "now"}, "part": {"form": "done"}}},
		{"features": {"who": "she", "when": "before"}, "compound": {"helper": {"who": "she", "when": "now"}, "part": {"form": "done"}}},
		{"features": {"who": "we", "when": "before"}, "compound": {"helper": {"who": "we", "when": "now"}, "part": {"form": "done"}}},
		{"features": {"who": "you-all", "when": "before"}, "compound": {"helper": {"who": "you-all", "when": "now"}, "part": {"form": "done"}}},
		{"features": {"who": "they", "when": "before"}, "compound": {"helper": {"who": "they", "when": "now"}, "part": {"form": "done"}}},

		{"features": {"who": "i", "when": "before", "written": "yes"}, "tags": ["first-person", "singular", "past"], "without": ["formal", "Flanders", "archaic", "imperative", "participle"]},
		{"features": {"who": "you", "when": "before", "written": "yes"}, "tags": ["second-person", "singular", "past"], "without": ["formal", "Flanders", "archaic", "imperative", "participle"]},
		{"features": {"who": "she", "when": "before", "written": "yes"}, "tags": ["third-person", "singular", "past"], "without": ["formal", "Flanders", "archaic", "imperative", "participle"]},
		{"features": {"who": "we", "when": "before", "written": "yes"}, "tags": ["plural", "past"], "without": ["formal", "Flanders", "archaic", "imperative", "participle"]},
		{"features": {"who": "you-all", "when": "before", "written": "yes"}, "tags": ["plural", "past"], "without": ["formal", "Flanders", "archaic", "imperative", "participle"]},
		{"features": {"who": "they", "when": "before", "written": "yes"}, "tags": ["plural", "past"], "without": ["formal", "Flanders", "archaic", "imperative", "participle"]},

		{"features": {"who": "i", "when": "later"}, "compound": {"verb": "zullen", "helper": {"who": "i", "when": "now"}, "part": {"form": "infinitive"}}},
		{"features": {"who": "you", "when": "later"}, "compound": {"verb": "zullen", "helper": {"who": "you", "when": "now"}, "part": {"form": "infinitive"}}},
		{"features": {"who": "she", "when": "later"}, "compound": {"verb": "zullen", "helper": {"who": "she", "when": "now"}, "part": {"form": "infinitive"}}},
		{"features": {"who": "we", "when": "later"}, "compound": {"verb": "zullen", "helper": {"who": "we", "when": "now"}, "part": {"form": "infinitive"}}},
		{"features": {"who": "you-all", "when": "later"}, "compound": {"verb": "zullen", "helper": {"who": "you-all", "when": "now"}, "part": {"form": "infinitive"}}},
		{"features": {"who": "they", "when": "later"}, "compound": {"verb": "zullen", "helper": {"who": "they", "when": "now"}, "part": {"form": "infinitive"}}},

		{"features": {"who": "i", "when": "now", "going": "yes"}, "compound": {"verb": "zijn", "helper": {"who": "i", "when": "now"}, "join": "aan het", "part": {"form": "infinitive"}}},
		{"features": {"who": "you", "when": "now", "going": "yes"}, "compound": {"verb": "zijn", "helper": {"who": "you", "when": "now"}, "join": "aan het", "part": {"form": "infinitive"}}},
		{"features": {"who": "she", "when": "now", "going": "yes"}, "compound": {"verb": "zijn", "helper": {"who": "she", "when": "now"}, "join": "aan het", "part": {"form": "infinitive"}}},
		{"features": {"who": "we", "when": "now", "going": "yes"}, "compound": {"verb": "zijn", "helper": {"who": "we", "when": "now"}, "join": "aan het", "part": {"form": "infinitive"}}},
		{"features": {"who": "you-all", "when": "now", "going": "yes"}, "compound": {"verb": "zijn", "helper": {"who": "you-all", "when": "now"}, "join": "aan het", "part": {"form": "infinitive"}}},
		{"features": {"who": "they", "when": "now", "going": "yes"}, "compound": {"verb": "zijn", "helper": {"who": "they", "when": "now"}, "join": "aan het", "part": {"form": "infinitive"}}},

		{"features": {"command": "yes", "who": "you"}, "tags": ["imperative", "present", "singular"], "without": ["archaic"]},
		{"features": {"command": "yes", "who": "you", "not": "yes"}, "tags": ["imperative", "present", "singular"], "without": ["archaic"], "shown": "{} niet", "inside": true},
		{"features": {"command": "yes", "who": "we"}, "tags": ["infinitive"], "shown": "laten we {}"}
	],

	"endings": {
		"about": "The regular endings, by the verb's last two letters, longest first where it matters. An empty ending says that having none is regular there: ik maak. A form that ends in one has that ending lit on the board, whatever its stem did.",
		"now": {"en": ["t", "en", ""], "an": ["t", "n", ""]},
		"now-i": {"en": [""], "an": [""]}
	},

	"middle": " Watch the middle of the word too: in some of these it changes.",
	"splits": " {Base} is a verb that splits in two: its front part goes to the end of the sentence, and joins up again where the whole verb is used.",

	"recipes": {
		"who": {
			"strategy": ["ending"],
			"description": "The ending says who is doing it: {1}, {2}, {3}, {4}. I has no ending at all.",
			"own_way": " {Base} is one of the verbs that go their own way, so learn these four as they are.",
			"rows": [
				{"english": "I {base}", "features": {"who": "i", "when": "now"}, "endings": "now-i", "wrap": "ik {}"},
				{"english": "You {base}", "features": {"who": "you", "when": "now"}, "endings": "now", "wrap": "jij {}"},
				{"english": "She {s}", "features": {"who": "she", "when": "now"}, "endings": "now", "wrap": "zij {}"},
				{"english": "We {base}", "features": {"who": "we", "when": "now"}, "endings": "now", "wrap": "wij {}"}
			]
		},
		"when": {
			"strategy": ["helper word", "ending"],
			"description": "For before, a form of hebben or zijn goes in front and the changed verb goes to the end: {2}. For later, a form of zullen goes in front: {3}.",
			"rows": [
				{"english": "I {base}", "features": {"who": "i", "when": "now"}, "wrap": "ik {}"},
				{"english": "I {past}", "features": {"who": "i", "when": "before"}, "mark_part": true, "wrap": "ik {}", "from": 1},
				{"english": "I will {base}", "features": {"who": "i", "when": "later"}, "wrap": "ik {}", "from": 1},
				{"english": "She {past}", "features": {"who": "she", "when": "before"}, "mark_part": true, "wrap": "zij {}"}
			]
		},
		"going": {
			"strategy": ["helper word"],
			"skip": "stative",
			"description": "For something going on right now, Dutch says I am at the doing of it: {2}.",
			"rows": [
				{"english": "I {base}", "features": {"who": "i", "when": "now"}, "wrap": "ik {}"},
				{"english": "I am {ing}", "features": {"who": "i", "when": "now", "going": "yes"}, "wrap": "ik {}", "from": 1},
				{"english": "She {s}", "features": {"who": "she", "when": "now"}, "wrap": "zij {}"},
				{"english": "She is {ing}", "features": {"who": "she", "when": "now", "going": "yes"}, "wrap": "zij {}", "from": 3}
			]
		},
		"command": {
			"strategy": ["helper word"],
			"skip": "stative",
			"description": "To tell someone to do something, the verb comes first and stands short: {1} Telling them not to puts niet after it: {3} For let's, laten we and the whole verb: {4}",
			"rows": [
				{"english": "{Base}!", "features": {"command": "yes", "who": "you"}, "wrap": "{}!", "capital": true},
				{"english": "{Base}, please!", "features": {"command": "yes", "who": "you"}, "wrap": "{} alsjeblieft!", "capital": true, "words": ["alsjeblieft"], "says": {"command": "yes", "who": "you", "please": "yes"}},
				{"english": "Do not {base}!", "features": {"command": "yes", "who": "you", "not": "yes"}, "wrap": "{} niet!", "capital": true, "words": ["niet"], "from": 1},
				{"english": "Let's {base}!", "features": {"command": "yes", "who": "we"}, "wrap": "Laten we {}!", "words": ["Laten we"]}
			]
		}
	},

	"verbs": {
